# Application Environment Configuration
# Copy this file to .env and fill in your values.

# Database: SQLite for local development, or PostgreSQL for Vercel / production deployment
# Local SQLite:
DATABASE_URL="file:./data/dev.db"
# Production PostgreSQL (Neon, Supabase, Vercel Postgres, AWS RDS, etc.):
# DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API Key for OCR, classification, and email generation
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"
# Separate controls for screenshot extraction, personalized email writing, and ATS analysis.
# GEMINI_MODEL is still supported as a fallback if these are unset.
GEMINI_EXTRACTION_MODEL="gemini-3.8-flash"
GEMINI_EMAIL_MODEL="gemini-3.8-flash"
GEMINI_ATS_MODEL="gemini-2.5-flash"

# Google OAuth 2.0 Credentials for Gmail API
# Obtain from Google Cloud Console: https://console.cloud.google.com/
# Required API: Gmail API
# Scopes: https://www.googleapis.com/auth/gmail.send, https://www.googleapis.com/auth/userinfo.email
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Token Encryption Secret (32-byte hex string used for AES-256-GCM token encryption at rest)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Optional fallback key during rotation
OLD_ENCRYPTION_SECRET=""

# Server-Side Session Signing Secret (32-byte hex string for HMAC-SHA256 session signatures)
SESSION_SECRET="fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210"

# Storage Provider: "local" (default) or "blob" (required on Vercel)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"
# Vercel Blob Token (Required when deploying to Vercel with STORAGE_PROVIDER="blob")
# Automatically set by Vercel when connecting a Blob store, or add manually:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Concurrency & Retries
PROCESSING_CONCURRENCY="3"
MAX_PROCESSING_RETRIES="2"

# Verified User Authentication Credentials (Used to authenticate User A and User B sessions)
USER_A_PASSWORD="UserA_PilotPass_2026!"
USER_B_PASSWORD="UserB_PilotPass_2026!"
